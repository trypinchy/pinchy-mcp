{
  "name": "pinchy-mcp",
  "version": "0.1.0",
  "description": "MCP server that finds working coupon codes for any online store.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coupons",
    "promo-codes",
    "shopping",
    "ai-agents",
    "coupon-codes",
    "discount-codes",
    "chrome-extension",
    "pinchy"
  ],
  "homepage": "https://github.com/trypinchy/pinchy-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trypinchy/pinchy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/trypinchy/pinchy-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pinchy-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && rm -rf dist && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
